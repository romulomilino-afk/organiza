# Copie para .env e preencha. Só DATABASE_URL e AUTH_SECRET são obrigatórios.
# Gere todos os segredos de uma vez com:  npm run secrets

# ─── Básico ───
DATABASE_URL="postgresql://organiza:organiza@localhost:5432/organiza"
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Endereço público do app (usado nos links de convite). Em produção: https://seu-dominio
AUTH_URL="http://localhost:3000"

# Plano de novos cadastros só no computador (em produção é sempre FREE + 7 dias de teste): FREE | PREMIUM | FAMILY
DEFAULT_PLAN="PREMIUM"

# ─── Login com Google (opcional) ───
# Redirect URI no Google Cloud: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── IA da Nina (Claude). Sem chave, a Nina usa o modo simples (regras) ───
ANTHROPIC_API_KEY=""
NINA_MODEL="claude-haiku-4-5-20251001"       # rápido e barato: o dia a dia
NINA_MODEL_SMART="claude-sonnet-5-5"            # mais esperto: pedidos longos, áudios e perguntas de análise ("off" desliga)

# ─── Áudio → texto no servidor (opcional; necessário para áudios do WhatsApp) ───
OPENAI_API_KEY=""
TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# ─── Tarefas periódicas (avisos e assinaturas) ───
# O agendador chama /api/cron/tick a cada 5 min com: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# ─── Notificações push (Web Push / VAPID) ───
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@seu-dominio.com.br"

# ─── Arquivos (documentos) ───
# Chave de criptografia dos arquivos: 64 caracteres hex. NUNCA troque depois de ter arquivos guardados.
FILES_ENCRYPTION_KEY=""
STORAGE_DRIVER=""               # vazio = automático (local no computador, banco no Netlify) | db | s3
STORAGE_DIR="./storage"
# Para S3 / Cloudflare R2 / MinIO:
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                  # R2: https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Pagamentos (Asaas) ───
ASAAS_ENV="sandbox"             # sandbox | production
ASAAS_API_KEY=""                # sandbox começa com $aact_hmlg_
ASAAS_WEBHOOK_TOKEN=""          # 32+ caracteres; o mesmo cadastrado no webhook do Asaas

# ─── WhatsApp (Cloud API da Meta) ───
WHATSAPP_TOKEN=""               # token de acesso permanente (usuário do sistema)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""          # para conferir a assinatura dos webhooks
WHATSAPP_VERIFY_TOKEN=""        # você inventa; o mesmo na configuração do webhook
WHATSAPP_DISPLAY_NUMBER=""      # número exibido no app, ex.: +55 21 99999-0000
WHATSAPP_GRAPH_VERSION="v22.0"
